# App
DATABASE_URL=file:./data/aicomic.db
UPLOAD_DIR=./uploads

# AI providers (optional — can also be configured in the in-app Settings page)
# Atlas Cloud — one key covers text (OpenAI-compatible), image & video.
# When set and no OpenAI/Gemini/Seedance key is present, it is used as the default
# provider for text, image and video. Get a key at https://www.atlascloud.ai
ATLASCLOUD_API_KEY=your-atlascloud-api-key
# Optional overrides:
# ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/v1
# ATLASCLOUD_MODEL=deepseek-ai/DeepSeek-V3-0324
# ATLASCLOUD_VIDEO_MODEL=bytedance/seedance-2.0-fast/image-to-video
