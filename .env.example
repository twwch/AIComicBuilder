# App
DATABASE_URL=file:./data/aicomic.db
UPLOAD_DIR=./uploads

# Concurrent generation
# Total background tasks processed at the same time.
TASK_WORKER_CONCURRENCY=4
# Per API key image requests at the same time. Keep 1 unless your provider allows more.
IMAGE_KEY_POOL_PER_KEY_CONCURRENCY=1
# Cool down a key for this long after 429/quota/throttle-like errors.
IMAGE_KEY_POOL_COOLDOWN_MS=10000

# Image API key pools.
# You can separate keys with commas, semicolons, spaces, or new lines.
OPENAI_API_KEYS=
GEMINI_API_KEYS=
DASHSCOPE_API_KEYS=
KLING_ACCESS_KEYS=
KLING_SECRET_KEYS=
JIMAPI_API_KEYS=
IMAGE2_API_KEYS=
IMAGE_EDIT_API_KEYS=

# JimAPI / ToAPIs-compatible video provider
JIMAPI_BASE_URL=https://www.jimapi.com/v1
JIMAPI_API_KEY=

# JimAPI / Image2-compatible asset image provider
JIMAPI_IMAGE_ENDPOINT=https://www.jimapi.com/v1/images/generations
JIMAPI_IMAGE_MODEL=gpt-image-2
JIMAPI_IMAGE_QUALITY=high
IMAGE2_TIMEOUT_MS=300000

JIMAPI_VIDEO_MODEL=viduq3-turbo
# These may be either paths under JIMAPI_BASE_URL or full URLs from the supplier.
JIMAPI_VIDEO_ENDPOINT_PATH=/videos/generations
JIMAPI_UPLOAD_IMAGE_ENDPOINT_PATH=/uploads/images
